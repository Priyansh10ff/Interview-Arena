# Option 1 — OpenRouter key (https://openrouter.ai/keys)
# Supports gpt-4o-mini and 100+ other models
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2 — Direct OpenAI key (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: If neither key is set here, the app will ask you to enter
# your key in the UI on first launch. No .env needed at all.

# ── Firebase (required) ─────────────────────────────────────────────
# Create project at https://console.firebase.google.com
# Project Settings → Your apps → Web app → copy config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
